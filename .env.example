# Configurações do Supabase (Project Settings -> API no painel do Supabase)
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# OAuth Google (opcional para login social)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=seu-client-id-web.apps.googleusercontent.com

